          ],
          "path": [
            "auth",
            "reset-password"
          ]
        },
        "description": "RNF-01, criterio 2. Falla mientras DEF-A01 siga abierto. Va al final porque cambia la contrasena de la cuenta de prueba.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identification\": \"{{identification}}\",\n  \"email\": \"{{email}}\",\n  \"new_password\": \"Tomada-Postman-123\"\n}"
        }
      }
