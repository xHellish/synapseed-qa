        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "RF-02, criterio 3.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identification\": \"{{identification}}\",\n  \"password\": \"Incorrecta-123\"\n}"
        }
      }
    },
