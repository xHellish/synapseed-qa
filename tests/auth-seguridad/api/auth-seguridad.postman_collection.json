            "exec": [
              "pm.test(\"responde 401\", function () {",
              "  pm.response.to.have.status(401);",
              "});",
              "// Se guarda el mensaje para compararlo con el de una cedula inexistente",
              "pm.collectionVariables.set(\"wrong_password_detail\", pm.response.json().detail);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
