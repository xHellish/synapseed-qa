    {
      "name": "CP-RNF01-02 Perfil con token alterado (DEF-A11)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Altera el payload del token conservando la firma original",
              "const parts = pm.collectionVariables.get(\"token\").split(\".\");",
              "const tampered_payload = btoa(JSON.stringify({ sub: \"999999\" })).replace(/=+$/, \"\");",
              "pm.collectionVariables.set(\"tampered_token\", parts[0] + \".\" + tampered_payload + \".\" + parts[2]);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"el token alterado no da acceso\", function () {",
              "  pm.expect(pm.response.code).to.not.eql(200);",
              "});",
              "pm.test(\"DEF-A11: responde 401 sin detalles de configuracion\", function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.text()).to.not.include(\"SUPABASE\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tampered_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "me"
          ]
        },
        "description": "RNF-01, criterios 1 y 7. La segunda prueba falla mientras DEF-A11 siga abierto."
      }
    },
    {
      "name": "CP-RNF01-01 Reset de contrasena sin verificacion (DEF-A01)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"DEF-A01: el reset sin prueba de control de la cuenta se rechaza\", function () {",
              "  pm.expect(pm.response.code).to.not.eql(204);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
