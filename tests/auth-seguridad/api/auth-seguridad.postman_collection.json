    {
      "name": "CP-RF02-05 Perfil propio con token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"es el perfil de la persona autenticada\", function () {",
              "  pm.expect(pm.response.json().identification).to.eql(pm.collectionVariables.get(\"identification\"));",
              "});",
              "// El perfil nunca debe exponer la contrasena ni su hash",
              "pm.test(\"no expone la contrasena ni su hash\", function () {",
              "  const profile = pm.response.json();",
              "  for (const field of [\"password\", \"password_hash\", \"hashed_password\"]) {",
              "    pm.expect(profile).to.not.have.property(field);",
              "  }",
              "});"
            ]
          }
        }
