            "login"
          ]
        },
        "description": "RF-02, criterio 3. La cedula 600000000 no la genera la coleccion.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identification\": \"600000000\",\n  \"password\": \"Incorrecta-123\"\n}"
        }
      }
    },
