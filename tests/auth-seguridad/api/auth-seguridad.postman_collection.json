    {
      "name": "CP-RF02-01 Login valido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const login = pm.response.json();",
              "pm.test(\"entrega un JWT bearer\", function () {",
              "  pm.expect(login.token_type).to.eql(\"bearer\");",
              "  pm.expect(login.access_token.split(\".\").length).to.eql(3);",
              "});",
              "pm.test(\"el JWT expira en 24 horas\", function () {",
              "  pm.expect(login.expires_in).to.eql(86400);",
              "});",
              "// Se guarda el token para las peticiones siguientes",
              "pm.collectionVariables.set(\"token\", login.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "RF-02, criterios 1 y 2.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identification\": \"{{identification}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
