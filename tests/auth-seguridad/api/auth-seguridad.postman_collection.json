        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"otra.{{email}}\",\n  \"full_name\": \"Persona Duplicada\",\n  \"identification\": \"{{identification}}\",\n  \"phone\": \"88880000\",\n  \"password\": \"{{password}}\"\n}"
        }
