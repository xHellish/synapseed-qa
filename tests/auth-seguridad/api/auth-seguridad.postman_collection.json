          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"no autentica (401 o 422)\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([401, 422]);",
              "  pm.expect(pm.response.text()).to.not.include(\"access_token\");",
              "});"
            ]
