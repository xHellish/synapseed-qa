{
  "info": {
    "name": "SynapSeed QA - Auth y seguridad",
    "description": "Pruebas de API de RF-01, RF-02 y RNF-01 contra el ambiente QA local. Responsable: Ben Farz (Persona A). Cada request lleva el ID de su caso de prueba (docs/casos-prueba/casos-A.md). Usa una cedula sintetica nueva en cada corrida. Las pruebas marcadas con DEF-A01 y DEF-A11 fallan mientras esos defectos sigan abiertos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "identification",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tampered_token",
      "value": ""
    },
    {
      "key": "wrong_password_detail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "CP-RF01-01 Registro valido",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Genera una cedula sintetica de 9 digitos que empieza en 6 (las de pytest empiezan en 8 y las de k6 en 7)",
              "let identification = \"6\";",
              "for (let position = 0; position < 8; position++) {",
              "  identification = identification + String(Math.floor(Math.random() * 10));",
              "}",
              "pm.collectionVariables.set(\"identification\", identification);",
              "pm.collectionVariables.set(\"email\", \"qa.postman.\" + identification + \"@example.com\");",
              "pm.collectionVariables.set(\"password\", \"QaPostman-\" + identification);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"devuelve la cedula registrada\", function () {",
              "  pm.expect(pm.response.json().identification).to.eql(pm.collectionVariables.get(\"identification\"));",
              "});",
              "// El perfil nunca debe exponer la contrasena ni su hash",
              "pm.test(\"no expone la contrasena ni su hash\", function () {",
              "  const profile = pm.response.json();",
              "  for (const field of [\"password\", \"password_hash\", \"hashed_password\"]) {",
              "    pm.expect(profile).to.not.have.property(field);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "RF-01, criterio 1. Registro con datos validos y sinteticos.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"full_name\": \"Persona Postman {{identification}}\",\n  \"identification\": \"{{identification}}\",\n  \"phone\": \"88880000\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
